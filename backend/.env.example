PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/secure_file_sharing
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=1d
AES_KEY=32_character_long_aes_secret_key!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Secure File Sharing <no-reply@example.com>"
CLIENT_URL=http://localhost:5173
OTP_TTL_MINUTES=10
FILE_EXPIRY_MINUTES=10
